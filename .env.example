# Binance API (only needed for --live execution; market data is public)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
BINANCE_IS_DEMO=true

# RabbitMQ broker for publishing TPS signals to followers
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
SEND_COPY_TRADE=false

# Trading config
TPS_SYMBOL=BTCUSDC
TPS_ENTRY_TIMEFRAME=15m
TPS_NEWS_FILTER=false
DEFAULT_RISK_USDT=5.0

# paper | live
EXECUTION_MODE=paper
